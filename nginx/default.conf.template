# Plain http only redirects to https.
# __HTTPS_PORT_SUFFIX__ is filled in at start-up: empty for port 443, otherwise ":<port>".
server {
    listen 80;
    return 301 https://$host__HTTPS_PORT_SUFFIX__$request_uri;
}

server {
    listen 443 ssl;

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy no-referrer always;

    client_max_body_size 5m;

    # Look up the dashboard container's address on every request (Docker's
    # built-in DNS), instead of once at start-up. Otherwise, when an update
    # restarts the dashboard with a new address, the proxy keeps using the old
    # one and every page fails with "502 Bad Gateway".
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $dashboard http://web:8501;

    location / {
        proxy_pass $dashboard;
        proxy_http_version 1.1;
        # Streamlit uses websockets
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # $http_host keeps the port (e.g. server:8443). Streamlit compares it with
        # the browser's Origin, and refuses the live connection if they differ.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 86400;
    }
}

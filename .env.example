# ======================================================================
#  Settings for the MSP Partner Console
#  Copy this file to .env (setup.sh does this for you) and edit .env.
#  NEVER upload .env to GitHub. The .gitignore file already blocks it.
#  Every setting is explained in CUSTOMIZING.md.
# ======================================================================

# ---- Sophos API (required) -------------------------------------------
# Create a read-only API credential in Sophos Central Partner
# (Settings & Policies > API Credentials) and paste both values here.
SOPHOS_CLIENT_ID=paste-the-client-id-here
SOPHOS_CLIENT_SECRET=paste-the-client-secret-here

# ---- Your time zone and schedule -------------------------------------
# Time zone name from https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# for example America/Chicago, Europe/London, Australia/Sydney
TZ=UTC
# Hour of the day (0-23, in TZ) for the daily data collection
COLLECT_HOUR=6
# Day of the month your distributor counts MSP Flex usage
BILLING_DAY=22
# Months of history to keep
RETENTION_MONTHS=24

# ---- Branding --------------------------------------------------------
# Name shown in the browser tab, on the sign-in page and in titles
BRAND_NAME=MSP Partner Console
# Your company name, shown at the top of the sidebar (leave empty to hide)
BRAND_ORG=
# Short line under the title on the sign-in page (leave empty to hide)
BRAND_TAGLINE=
# Small text at the bottom of each page, e.g. a support contact (leave empty to hide)
BRAND_FOOTER=
# Logo and icon: put the files in the "branding" folder and give their names here
# (leave BRAND_LOGO empty for no logo; BRAND_ICON can also be an emoji)
BRAND_LOGO=
BRAND_ICON=🛡️
# Accent colour for buttons and highlights, as a hex colour code
BRAND_COLOR="#2563eb"
# Starting appearance for people who haven't picked one yet: auto (follows
# their device), light, or dark. Everyone can switch in the menu at the top
# right of the page; their browser remembers the choice.
THEME=auto

# ---- Labels ----------------------------------------------------------
# What each Sophos tenant billing type is called on screen
LABEL_FLEX=Flex
LABEL_TERM=Term
LABEL_TRIAL=Trial

# ---- Analysis --------------------------------------------------------
# Customer name prefixes that get a combined call-out on the Trends page,
# comma separated, e.g. Acme,Contoso   (leave empty for none)
GROUP_PREFIXES=
# Product moves to show as "Moved X -> Y" rather than a loss and a gain
PRODUCT_MOVES=MDR Complete>MDR Plus;MDR Essentials>MDR
# Days without reporting before a firewall stops counting as live
FIREWALL_STALE_DAYS=35

# ---- Sign-in security ------------------------------------------------
# Sign people out after this many minutes without using the dashboard
SESSION_TIMEOUT_MINUTES=120
# Wrong passwords in a row before a user name is locked, and for how long
SIGNIN_MAX_FAILURES=5
SIGNIN_LOCKOUT_MINUTES=15
# Wrong passwords allowed from one computer per minute (any user name)
SIGNIN_MAX_PER_IP_PER_MINUTE=10
# Hide error details (tracebacks) from viewers; they still go to the web log.
# Uncomment to turn on:
# STREAMLIT_CLIENT_SHOW_ERROR_DETAILS=type

# ---- Web address and ports -------------------------------------------
# The name people type in the browser (used in the self-signed certificate)
SERVER_NAME=partner-console
# Ports on the server. Change only if something else already uses 443 or 80.
# After changing a port, run:  bash open-firewall.sh
HTTPS_PORT=443
HTTP_PORT=80
# Optional: listen on only one of the server's IP addresses (leave empty for all)
LISTEN_ADDRESS=
